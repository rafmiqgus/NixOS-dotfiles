{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "ask",
    "bash": "ask"
  },
  "provider": {
    "ocp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OCP (Claude via local proxy)",
      "options": {
        "baseURL": "http://127.0.0.1:3456/v1",
        "apiKey": "dummy"
      },
      "models": {
        "claude-opus-5-5": { "name": "Claude via OCP (Opus 5.5)" },
        "claude-sonnet-5-5": { "name": "Claude via OCP (Sonnet 5.5)"},
        "claude-haiku-4-5-20251001": { "name": "Claude via OCP (Haiku 4.5)"}
      }
    }
  },
  "mcp": {
    "NixosMCP": {
      "type": "local",
      "command": ["mcp-nixos"],
      "enabled": true
    },
    "context-mode": {
      "type": "local",
      "command": ["npx", "-y", "context-mode"],
      "enabled": true
    }
  },
  "plugin": ["context-mode", "@simonwjackson/opencode-direnv"]
}
